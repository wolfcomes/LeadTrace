# Development port exposed to the LAN. Formal deployment will terminate HTTPS.
LEADTRACE_PORT=8876

# Replace both placeholders before the first non-development deployment.
POSTGRES_PASSWORD=replace-with-a-random-database-password
LEADTRACE_SESSION_SECRET=replace-with-at-least-32-random-characters
LEADTRACE_DEFAULT_ACCOUNT_PASSWORD=replace-with-a-protected-local-default

# JSON list. Use only the approved LAN hostname and/or fixed LAN IP.
LEADTRACE_ALLOWED_HOSTS=["leadtrace.lan","10.0.0.20"]

# JSON object mapping registered source-root keys to read-only container paths.
LEADTRACE_SOURCE_ROOTS={"source_pdfs":"/var/lib/leadtrace/source_pdfs"}

# Read-only dataset directory containing 01_manifest and 09_paper_review.
# Leave empty to disable the Admin HTTP machine-evidence backfill operation.
LEADTRACE_BASELINE_IMPORT_ROOT=
LEADTRACE_BASELINE_SOURCE_MANIFEST=
LEADTRACE_BASELINE_EXPECTED_AGGREGATE=

# Optional AI prefill adapter for the first pilot. Both host directories are
# mounted into Worker read-only. The legacy root contains 01_manifest and
# 09_paper_review; the Source root contains the authoritative PDFs.
LEADTRACE_AI_PREFILL_ENGINE=legacy_pipeline
LEADTRACE_AI_PREFILL_ENGINE_VERSION=pilot-v1
LEADTRACE_AI_PREFILL_LEGACY_HOST_ROOT=../../source_pdfs/分子修改提取_2024_JMC
LEADTRACE_SOURCE_PDFS_HOST_ROOT=../../source_pdfs

# Keep enabled when Nginx can read the managed asset volume through its
# internal-only location. Native FastAPI development may leave this false.
LEADTRACE_NGINX_INTERNAL_TRANSFER=true
